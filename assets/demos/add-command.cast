[18.26657, "o", "\u001b[?2026h\u001b[?25l\u001b[28A\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m\u001b[0m\u001b[48;2;40;50;40m                                                                                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  -- subscribe to a lifecycle event\u001b[0m\u001b[48;2;40;50;40m                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  psi.events.on(\"turn-end\", function(payload)\u001b[0m\u001b[48;2;40;50;40m                                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    psi.notice.info(\u001b[0m\u001b[48;2;40;50;40m                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      (\"[hello] turn ended, %d chars\"):format(#(payload.text or \"\")),\u001b[0m\u001b[48;2;40;50;40m                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      { source = \"hello-extension\" })\u001b[0m\u001b[48;2;40;50;40m                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  end)\u001b[0m\u001b[48;2;40;50;40m                                                                                                        \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[5B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212m$ sed -n 35,50p docs/extensions.md\u001b[0m\u001b[48;2;40;50;40m                                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[3B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mTUI hooks do not need to unregister themselves first.\u001b[0m\u001b[48;2;40;50;40m                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m\u001b[0m\u001b[48;2;40;50;40m                                                                                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m## Extension skeleton\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m```lua\u001b[0m\u001b[48;2;40;50;40m                                                                                                        \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m-- ~/.config/psi/extensions/hello.lua\u001b[0m\u001b[48;2;40;50;40m                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mreturn function(psi)\u001b[0m\u001b[48;2;40;50;40m                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  -- register a tool\u001b[0m\u001b[48;2;40;50;40m                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  psi.tools.register(psi.records.new_tool(\u001b[0m\u001b[48;2;40;50;40m                                                                    \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    \"hello\",                                  -- name (LLM-visible)\u001b[0m\u001b[48;2;40;50;40m                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[7B\r\u001b[2K\u001b[38;2;102;102;102m↑8\u001b[0m \u001b[38;2;102;102;102m↓210\u001b[0m \u001b[38;2;102;102;102mR8.1k\u001b[0m \u001b[38;2;102;102;102mW3.0k\u001b[0m \u001b[38;2;102;102;102mCH91.7%\u001b[0m \u001b[38;2;102;102;102m0.5%/1.0M (auto)\u001b[0m                                              \u001b[38;2;102;102;102mclaude-opus-5-5 • low\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2A\r\u001b[1G\u001b[?25h\u001b[?2026l"]
