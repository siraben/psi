[12.421418, "o", "\u001b[?2026h\u001b[?25l\u001b[23A\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m Read the command example in docs/extensions.md. Write .psi/extensions/greet.lua registering /greet [name],    \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m default world, printing Hello, <name>! using psi.commands.register and new_command_action. I will type /reload\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m then /greet Sakura. Do not start another psi. Finish in one sentence.                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[14B\r\u001b[2K                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;95;135;175m⠋\u001b[0m \u001b[38;2;102;102;102mWorking...\u001b[0m                                                                                                   \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;95;135;175m───────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;138;190;183m\u001b[0m                              