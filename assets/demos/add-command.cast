              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mreturn function(psi)\u001b[0m\u001b[48;2;40;50;40m                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  psi.commands.register(\"greet\", {\u001b[0m\u001b[48;2;40;50;40m                                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    description = \"Print a greeting\",\u001b[0m\u001b[48;2;40;50;40m                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    argument_hint = \"[name]\",\u001b[0m\u001b[48;2;40;50;40m                                                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    handler = function(rest)\u001b[0m\u001b[48;2;40;50;40m                                                                                  \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      local name = (rest or \"\"):match(\"^%s*(.-)%s*$\")\u001b[0m\u001b[48;2;40;50;40m                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      if name == \"\" then name = \"world\" end\u001b[0m\u001b[48;2;40;50;40m                                                                   \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      return psi.records.new_command_action(\"print\", \"Hello, \" .. name .. \"!\")\u001b[0m\u001b[48;2;40;50;40m                                \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    end,\u001b[0m\u001b[48;2;40;50;40m                                                                                                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  })\u001b[0m\u001b[48;2;40;50;40m                                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m... (1 more lines, 11 total,\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mctrl+o\u001b[0m\u001b[48;2;40;50;40m\u001b[38;2;128;128;128m to expand)\u001b[0m\u001b[48;2;40;50;40m                                                                \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2KI wrote \u001b[38;2;138;190"]
[48.624622, "o", ";183m.psi/extensions/greet.lua\u001b[0m, which registers \u001b[38;2;138;190;183m/greet [name]\u001b[0m (defaulting to \u001b[38;2;138;190;183mworld\u001b[0m) with                    \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;138;190;183mpsi.commands.register\u001b[0m and \u001b[38;2;138;190;183mnew_command_action\u001b[0m; I haven't run it, but after \u001b[38;2;138;190;183m/reload\u001b[0m, \u001b[38;2;138;190;183m/greet Sakura\u001b[0m should print  \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;138;190;183mHello, Sakura!\u001b[0m.                                                                                                \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102mHello, world!\u001b[0m                                                                                                  \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;95;135;175m───────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;138;190;183m\u001b[0m/greet                                                                                                         \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;95;135;175m───────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1A\r\u001b[8G\u001b[?25h\u001b[?2026l"]
