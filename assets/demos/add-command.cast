[20.831217, "o", "\u001b[?2026h\u001b[?25l\u001b[28A\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m## Extension skeleton\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m\u001b[0m\u001b[48;2;40;50;40m                                                                                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m```lua\u001b[0m\u001b[48;2;40;50;40m                                                                                                        \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m-- ~/.config/psi/extensions/hello.lua\u001b[0m\u001b[48;2;40;50;40m                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mreturn function(psi)\u001b[0m\u001b[48;2;40;50;40m                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  -- register a tool\u001b[0m\u001b[48;2;40;50;40m                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  psi.tools.register(psi.records.new_tool(\u001b[0m\u001b[48;2;40;50;40m                                                                    \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    \"hello\",                                  -- name (LLM-visible)\u001b[0m\u001b[48;2;40;50;40m                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mTook 0.0s\u001b[0m\u001b[48;2;40;50;40m                                                                                                     \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212mwrite\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;138;190;183m.psi/extensions/greet.lua\u001b[0m\u001b[48;2;40;50;40m                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mreturn function(psi)\u001b[0m\u001b[48;2;40;50;40m                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  psi.commands.register(\"greet\", {\u001b[0m\u001b[48;2;40;50;40m                                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    description = \"Print a greeting\",\u001b[0m\u001b[48;2;40;50;40m                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    argument_hint = \"[name]\",\u001b[0m\u001b[48;2;40;50;40m                                                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    handler = function(rest)\u001b[0m\u001b[48;2;40;50;40m                                                                                  \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      local name = (rest or \"\"):match(\"^%s*(.-)%s*$\")\u001b[0m\u001b[48;2;40;50;40m                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      if name == \"\" then name = \"world\" end\u001b[0m\u001b[48;2;40;50;40m                                                                   \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      return psi.records.new_command_action(\"print\", \"Hello, \" .. name .. \"!\")\u001b[0m\u001b[48;2;40;50;40m                                \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;1"]
[20.831243, "o", "28;128;128m    end,\u001b[0m\u001b[48;2;40;50;40m                                                                                                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  })\u001b[0m\u001b[48;2;40;50;40m                                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m... (1 more lines, 11 total,\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mctrl+o\u001b[0m\u001b[48;2;40;50;40m\u001b[38;2;128;128;128m to expand)\u001b[0m\u001b[48;2;40;50;40m                                                                \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[6B\r\u001b[2K\u001b[38;2;102;102;102m↑10\u001b[0m \u001b[38;2;102;102;102m↓423\u001b[0m \u001b[38;2;102;102;102mR13k\u001b[0m \u001b[38;2;102;102;102mW3.4k\u001b[0m \u001b[38;2;102;102;102mCH91.9%\u001b[0m \u001b[38;2;102;102;102m0.5%/1.0M (auto)\u001b[0m                                              \u001b[38;2;102;102;102mclaude-opus-5-5 • low\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2A\r\u001b[1G\u001b[?25h\u001b[?2026l"]
