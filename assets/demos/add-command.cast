[14.465546, "o", "\u001b[?2026h\u001b[?25l\u001b[28A\r\u001b[2K\u001b[38;2;102;102;102mPress Ctrl-O to show full startup help.\u001b[0m                                                                        \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102mpsi can explain its own features and look up its docs. Ask it how to use or extend psi.\u001b[0m                        \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m Read the command example in docs/extensions.md. Write .psi/extensions/greet.lua registering /greet [name],    \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m default world, printing Hello, <name>! using psi.commands.register and new_command_action. I will type /reload\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m then /greet Sakura. Do not start another psi. Finish in one sentence.                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212m$ grep -n -B3 -A30 \"commands.register\" docs/extensions.md 2>/dev/null | head -80 || true\u001b[0m\u001b[48;2;40;50;40m                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m... (63 earlier lines,\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mctrl+o\u001b[0m\u001b[48;2;40;50;40m\u001b[38;2;128;128;128m to expand)\u001b[0m\u001b[48;2;40;50;40m                                                                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m189-\u001b[0m\u001b[48;2;40;50;40m                                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m190-### Keybindings: `psi.keybindings`\u001b[0m\u001b[48;2;40;50;40m                                                                        \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m191-\u001b[0m\u001b[48;2;40;50;40m                                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m192-Keybinding metadata lives in `lua/psi/keybindings.lua`, mirroring pi's action-id\u001b[0m\u001b[48;2;40;50;40m                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m193-approach. TUI dispatch, footer hints, and `/hotkeys` all read from the same\u001b[0m\u001b[48;2;40;50;40m                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m194-resolved key map.\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m195-\u001b[0m\u001b[48;2;40;50;40m                                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m196-Users can override defaults in `~/.config/psi/keybindings.json` or\u001b[0m\u001b[48;2;40;50;40m                                        \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m197-`./.psi/keybindings.json`:\u001b[0m\u001b[48;2;40;50;40m                                                                                \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m198-\u001b[0m\u001b[48;2;40;50;40m                                                            "]
