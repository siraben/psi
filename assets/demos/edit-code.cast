                                                                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+2     if not values:\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+3         return 0\u001b[0m\u001b[48;2;40;50;40m                                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 2     return sum(values) / len(values)\u001b[0m\u001b[48;2;40;50;40m                                                                       \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 3 \u001b[0m\u001b[48;2;40;50;40m                                                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212m$ python3 test_mean.py\u001b[0m\u001b[48;2;40;50;40m                                                                                        \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m3 tests passed\u001b[0m\u001b[48;2;40;50;40m                                                                                                \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mTook 0.0s\u00