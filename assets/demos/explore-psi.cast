[20.512241, "o", "\u001b[?2026h\u001b[?25l\u001b[28A\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    return records.new_command_action(\"print\", \"command /\" .. first .. \" failed\")\u001b[0m\u001b[48;2;40;50;40m                             \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  end\u001b[0m\u001b[48;2;40;50;40m                                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  return result\u001b[0m\u001b[48;2;40;50;40m                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mend\u001b[0m\u001b[48;2;40;50;40m                                                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mTook 0.0s\u001b[0m\u001b[48;2;40;50;40m                                                                                                     \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212m$ cd /home/demo/psi; sed -n 1866,1880p lua/psi/slash_commands.lua; grep -n \"dispatch_registered\"              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212mlua/psi/slash_commands.lua\u001b[0m\u001b[48;2;40;50;40m                                                                                    \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m... (7 earlier lines,\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mctrl+o\u001b[0m\u001b[48;2;40;50;40m\u001b[38;2;128;128;128m to expand)\u001b[0m\u001b[48;2;40;50;40m                                                                       \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  if is_quit(line) then\u001b[0m\u001b[48;2;40;50;40m                                                                                       \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    return records.new_command_action(\"quit\", nil)\u001b[0m\u001b[48;2;40;50;40m                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  end\u001b[0m\u001b[48;2;40;50;40m                                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  if line == \"/session\" then\u001b[0m\u001b[48;2;40;50;40m                                                                                  \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    return records.new_command_action(\"print\", session_status())\u001b[0m\u001b[48;2;40;50;40m                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  end\u001b[0m\u001b[48;2;40;50;40m                                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  if line == \"/system-prompt\" then\u001b[0m\u001b[48;2;40;50;40m                                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    local prompt = require(\"psi.prompt\")\u001b[0m\u001b[48;2;40;50;40m                                                                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m1842:local function dispatch_registered(line)\u001b[0m\u001b[48;2;40;50;40m                                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m2005:  local registered_action = dispatch_registered(line)\u001b[0m\u001b[48;2;40;50;40m                                                    \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mTook 0.0s\u001b[0m\u001b[48;2;40;50;40m                                                                                         "]
[20.512273, "o", "            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2KHere's how \u001b[38;2;138;190;183m/greet\u001b[0m gets from the TUI to the Lua ext                                                             \u001b[0m\u001b]8;;\u0007\u001b[3B\r\u001b[1G\u001b[?25h\u001b[?2026l"]
[20.518886, "o", "\u001b[?2026h\u001b[?25l\u001b[28A\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    return records.new_command_action(\"quit\", nil)\u001b[0m\u001b[48;2;40;50;40m                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  if line == \"/session\" then\u001b[0m\u001b[48;2;40;50;40m                                                                                  \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    return records.new_command_action(\"print\", session_status())\u001b[0m\u001b[48;2;40;50;40m                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  end\u001b[0m\u001b[48;2;40;50;40m                                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  if line == \"/system-prompt\" then\u001b[0m\u001b[48;2;40;50;40m                                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    local prompt = require(\"psi.prompt\")\u001b[0m\u001b[48;2;40;50;40m                                                                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m1842:local function dispatch_registered(line)\u001b[0m\u001b[48;2;40;50;40m                                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m2005:  local registered_action = dispatch_registered(line)\u001b[0m\u001b[48;2;40;50;40m                                                    \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mTook 0.0s\u001b[0m\u001b[48;2;40;50;40m                                                                                                     \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2KHere's how \u001b[38;2;138;190;183m/greet\u001b[0m gets from the TUI to the Lua extension handler:                                              \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;138;190;183m•\u001b[0m \u001b[1m\u001b[38;2;138;190;183mlua/psi/tui_runtime.lua\u001b[0m\u001b[0m: When you press enter, \u001b[38;2;138;190;183msubmit()\u001b[0m (around line 4991) sees that the line starts with \u001b[38;2;138;190;183m/\u001b[0m  \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K  and sends it to \u001b[38;2;138;190;183mhandle_command()\u001b[0m (line 4693). That function handles \u001b[38;2;138;190;183m/quit\u001b[0m itself and passes everything else  \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K  to \u001b[38;2;138;190;183mcommands.handle(line)\u001b[0m, which comes from \u001b[38;2;138;190;183mrequire(\"psi.slash_commands\")\u001b[0m. If that returns \u001b[38;2;138;190;183mnil\u001b[0m, the status bar\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K  shows \"unknown command\".                                                                                     \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;138;190;183m•\u001b[0m \u001b[1m\u001b[38;2;138;190;183mlua/psi/slash_commands.lua\u001b[0m\u001b[0m: \u001b[38;2;138;190;183mM.handle()\u001b[0m (line 1866) checks the built-in commands first. If none match, it     \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K  calls \u001b[38;2;138;190;183mdispatch_registered(line)\u001b[0m at line 2005. That function (line 1842) splits the line into \u001b[38;2;138;190;183mgreet\u001b[0m and the   \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K  rest, then looks up \u001b[38;2;138;190;183mregistered[\"greet\"]\u001b[0m. It calls \u001b[38;2;138;190;183mpcall(command.handler, rest, line)\u001b[0m and returns the result  \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K  as an action for the TUI. If the handler throws, it shows \"command /greet failed\" instead.                   \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;138;190;183m•\u001b[0m \u001b[1mRegistration (\u001b[38;2;138;190;183mlua/boot.lua\u001b[0m, \u001b[38;2;138;190;183mlua/psi/slash_commands.lua\u001b[0m)\u001b[0m: \u001b[38;2;138;190;183mboot.lua:63\u001b[0m sets \u001b[38;2;138;190;183mpsi.commands =                     \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K  \u001b[38;2;138;190;183mrequire(\"psi.slash_commands\")\u001b[0m, so an extension can call \u001b[38;2;138;190;183mpsi.commands.register(\"greet\", fn)\u001b[0m. The example is in\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K  \u001b[38;2;138;190;183mdocs/extensions.md:73\u001b[0m. \u001b[38;2;138;190;183mM.register\u001b["]
