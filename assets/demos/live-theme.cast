[22.799624, "o", "\u001b[?2026h\u001b[?25l\u001b[28A\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mreleased Pi 0.87.1. Select via `\"theme\": \"pi-dark\"`, `theme.name`, or\u001b[0m\u001b[48;2;40;50;40m                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m`tui.theme` in settings. Custom themes can override only the slots they need\u001b[0m\u001b[48;2;40;50;40m                                  \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mand inherit the rest.\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m\u001b[0m\u001b[48;2;40;50;40m                                                                                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m| API | Notes |\u001b[0m\u001b[48;2;40;50;40m                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m... (51 more lines,\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mctrl+o\u001b[0m\u001b[48;2;40;50;40m\u001b[38;2;128;128;128m to expand)\u001b[0m\u001b[48;2;40;50;40m                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;255;255;0mOutput was truncated.\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212mwrite\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;138;190;183m.psi/extensions/amber.lua\u001b[0m\u001b[48;2;40;50;40m                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mreturn function(psi)\u001b[0m\u001b[48;2;40;50;40m                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  local bg = 52 -- dark warm (deep maroon-brown)\u001b[0m\u001b[48;2;40;50;40m                                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  psi.theme.register(\"amber\", {\u001b[0m\u001b[48;2;40;50;40m                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    tui = {\u001b[0m\u001b[48;2;40;50;40m                                                                                                   \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      header           = { fg = 214, bg = bg },\u001b[0m\u001b[48;2;40;50;40m                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      accent           = { fg = 220, bg = bg },\u001b[0m\u001b[48;2;40;50;40m                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;