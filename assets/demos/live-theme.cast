[13.784877, "o", "\u001b[?2026h\u001b[?25l\u001b[28A\r\u001b[2K\u001b[38;2;102;102;102mPress Ctrl-O to show full startup help.\u001b[0m                                                                        \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102mpsi can explain its own features and look up its docs. Ask it how to use or extend psi.\u001b[0m                        \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m Read the theme section of docs/extensions.md. Create .psi/extensions/amber.lua that registers and immediately \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m uses warm amber colors with a dark warm background on all TUI slots. I will type /reload to apply it live. Do \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m not change core or start another psi. Finish in one sentence.                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;52;53;65m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212m$ grep -n -i \"theme\" docs/extensions.md | head -50\u001b[0m\u001b[48;2;40;50;40m                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m... (4 earlier lines,\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mctrl+o\u001b[0m\u001b[48;2;40;50;40m\u001b[38;2;128;128;128m to expand)\u001b[0m\u001b[48;2;40;50;40m                                                                       \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m243:released Pi 0.87.1. Select via `\"theme\": \"pi-dark\"`, `theme.name`, or\u001b[0m\u001b[48;2;40;50;40m                                     \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m244:`tui.theme` in settings. Custom themes can override only the slots they need\u001b[0m\u001b[48;2;40;50;40m                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m249:| `psi.theme.register(name, spec)` | Add or replace a named theme. |\u001b[0m\u001b[48;2;40;50;40m                                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m250:| `psi.theme.use(name_or_spec)` | Apply a registered theme or an ad-hoc spec immediately. |\u001b[0m\u001b[48;2;40;50;40m               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m251:| `psi.theme.current()` | Returns the applied normalized theme table. |\u001b[0m\u001b[48;2;40;50;40m                                   \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m252:| `psi.theme.current_name()` | Returns the active theme name. |\u001b[0m\u001b[48;2;40;50;40m                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m253:| `psi.theme.names()` | Sorted array of registered theme names. |\u001b[0m\u001b[48;2;40;50;40m                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m255:Theme spec shape:\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m286:  psi.theme.register(\"toxic\", {\u001b[0m\u001b[48;2;40;50;40m                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m292:  psi.theme.use(\"toxic\")\u001b[0m\u001b[48;2;40;50;40m                                    "]
[13.784902, "o", "                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mTook 0.0s\u001b[0m\u001b[48;2;40;50;40m                                                                                                     \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[5B\r\u001b[2K\u001b[38;2;102;102;102m↑4\u001b[0m \u001b[38;2;102;102;102m↓67\u001b[0m \u001b[38;2;102;102;102mR2.5k\u001b[0m \u001b[38;2;102;102;102mCH99.8%\u001b[0m \u001b[38;2;102;102;102m0.3%/1.0M (auto)\u001b[0m                                                     \u001b[38;2;102;102;102mclaude-opus-5-5 • low\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2A\r\u001b[1G\u001b[?25h\u001b[?2026l"]
