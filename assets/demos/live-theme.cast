[20.373085, "o", "\u001b[?2026h\u001b[?25l\u001b[28A\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mTheme support stays Lua-first: extensions register a theme spec, then select it.\u001b[0m\u001b[48;2;40;50;40m                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mThe bundled `pi-dark` / `pi-light` themes (also `dark` / `light`) exactly match\u001b[0m\u001b[48;2;40;50;40m                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mreleased Pi 0.87.1. Select via `\"theme\": \"pi-dark\"`, `theme.name`, or\u001b[0m\u001b[48;2;40;50;40m                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m`tui.theme` in settings. Custom themes can override only the slots they need\u001b[0m\u001b[48;2;40;50;40m                                  \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mand inherit the rest.\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m\u001b[0m\u001b[48;2;40;50;40m                                                                                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m| API | Notes |\u001b[0m\u001b[48;2;40;50;40m                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m... (51 more lines,\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mctrl+o\u001b[0m\u001b[48;2;40;50;40m\u001b[38;2;128;128;128m to expand)\u001b[0m\u001b[48;2;40;50;40m                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;255;255;0mOutput was truncated.\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212mwrite\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;138;190;183m.psi/extensions/amber.lua\u001b[0m\u001b[48;2;40;50;40m                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mreturn function(psi)\u001b[0m\u001b[48;2;40;50;40m                                                                                          \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  local bg = 52 -- dark warm (deep maroon-brown)\u001b[0m\u001b[48;2;40;50;40m                                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m  psi.theme.register(\"amber\", {\u001b[0m\u001b[48;2;40;50;40m                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    tui = {\u001b[0m\u001b[48;2;40;50;40m                                                                                                   \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      header           = { fg = 214, bg = bg },\u001b[0m\u001b[48;2;40;50;40m                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      accent           = { fg = 220, bg = bg },\u001b[0m\u001b[48;2;40;50;40m                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      text             = { fg = 223, bg = bg },\u001b[0m\u001b[48;2;40;50;40m                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      warning          = { fg = 208, bg = bg },\u001b[0m\u001b[48;2;40;50;40m                                   "]
[20.373105, "o", "                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      success          = { fg = 178, bg = bg },\u001b[0m\u001b[48;2;40;50;40m                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m      error            = { fg = 202, bg = bg },\u001b[0m\u001b[48;2;40;50;40m                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m... (12 more lines, 22 total,\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mctrl+o\u001b[0m\u001b[48;2;40;50;40m\u001b[38;2;128;128;128m to expand)\u001b[0m\u001b[48;2;40;50;40m                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[6B\r\u001b[2K\u001b[38;2;102;102;102m↑8\u001b[0m \u001b[38;2;102;102;102m↓603\u001b[0m \u001b[38;2;102;102;102mR8.1k\u001b[0m \u001b[38;2;102;102;102mW1.7k\u001b[0m \u001b[38;2;102;102;102mCH72.2%\u001b[0m \u001b[38;2;102;102;102m0.5%/1.0M (auto)\u001b[0m                                              \u001b[38;2;102;102;102mclaude-opus-5-5 • low\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2A\r\u001b[1G\u001b[?25h\u001b[?2026l"]
