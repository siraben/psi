[10.047014, "o", "\u001b[?2026h\u001b[?25l\u001b[27A\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mdef greet(name):\u001b[0m\u001b[48;2;40;50;40m                                                                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m    return f\"Hello, {name}!\"\u001b[0m\u001b[48;2;40;50;40m                                                                                  \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m\u001b[0m\u001b[48;2;40;50;40m                                                                                                              \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mprint(greet(\"world\"))\u001b[0m\u001b[48;2;40;50;40m                                                                                         \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212medit\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;138;190;183mhello.py\u001b[0m\u001b[48;2;40;50;40m                                                                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;204;102;102m-1 def greet(name):\u001b[0m\u001b[48;2;40;50;40m                                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+1 def greet(name\u001b[7m=\"world\"\u001b[0m\u001b[48;2;40;50;40m):\u001b[0m\u001b[48;2;40;50;40m                                                                                   \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 2     return f\"Hello, {name}!\"\u001b[0m\u001b[48;2;40;50;40m                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 3 \u001b[0m\u001b[48;2;40;50;40m                                                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 4 print(greet(\"world\"))\u001b[0m\u001b[48;2;40;50;40m                                                                                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 5 \u001b[0m\u001b[48;2;40;50;40m                                                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212m$ python3 hello.py\u001b[0m\u001b[48;2;40;50;40m                                                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mHello, world!\u001b[0m\u001b[48;2;40;50;40m                                                                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mTook 0.0s\u001b[0m\u001b[48;2;40;50;40m                                                                                                     \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2KI changed \u001b[38;2;138;190;183mgreet\u001b[0m in                                                                                             \u001b[0m\u001b]8;;\u0007\u001b[3B\r\u001b[1G\u001b[?25h\u001b[?2026l"]
[10.071293, "o", "\u001b[?2026h\u001b[?25l\u001b[27A\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212medit\u001b[0m\u001b[48;2;40;50;40m \u001b[38;2;138;190;183mhello.py\u001b[0m\u001b[48;2;40;50;40m                                                                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;204;102;102m-1 def greet(name):\u001b[0m\u001b[48;2;40;50;40m                                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+1 def greet(name\u001b[7m=\"world\"\u001b[0m\u001b[48;2;40;50;40m):\u001b[0m\u001b[48;2;40;50;40m                                                                                   \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 2     return f\"Hello, {name}!\"\u001b[0m\u001b[48;2;40;50;40m                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 3 \u001b[0m\u001b[48;2;40;50;40m                                                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 4 print(greet(\"world\"))\u001b[0m\u001b[48;2;40;50;40m                                                                                      \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m 5 \u001b[0m\u001b[48;2;40;50;40m                                                                                                           \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[2B\r\u001b[2K\u001b[38;2;102;102;102m\u001b[0m                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[1;38;2;212;212;212m$ python3 hello.py\u001b[0m\u001b[48;2;40;50;40m                                                                                            \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m                                                                                                               \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mHello, world!\u001b[0m\u001b[48;2;40;50;40m                                                                                                 \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;102;102;102mTook 0.0s\u001b[0m\u001b[48;2;40;50;40m                                                                                                     \u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[3B\r\u001b[2KI changed \u001b[38;2;138;190;183mgreet\u001b[0m in \u001b[38;2;138;190;183mhello.py\u001b[0m so that \u001b[38;2;138;190;183mname\u001b[0m defaults to \u001b[38;2;138;190;183m\"world\"\u001b[0m: \u001b[38;2;138;190;183mdef greet(name=\"world\"):\u001b[0m. When I ran the script, \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2Kit printed:                                                                                                    \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;128;128;128m```\u001b[0m                                                                                                            \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;181;189;104mHello, world!\u001b[0m                                                                                                  \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;128;128;128m```\u001b[0m                                                                                                            \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K                                                                                                               \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2KThe script still calls \u001b[38;2;138;190;183mgreet(\"world\")\u001b[0m with the name passed in, so this run didn't use the new default. Calling \u001b[0m\u001b]8;;\u0007\u001b[1B\r\u001b[2K\u001b[38;2;138;190;183mgreet()\u001b[0m with no argument would now print the same thing.                                                       \u001b[0m\u001b]8;;\u0007\u001b[4B\r\u001b[2K\u001b[38;2;102;102;102m↑8.2k\u001b[0m \u001b[38;2;102;102;102m↓317\u001b[0m \u001b[38;2;102;102;102m0.3%/1.0M (auto)\u001b[0m           "]
